import Mathlib

/-!
# Definitions and the main statement (Theorem 1)

Everything takes place inside `ℂ`.

* A number field is a subfield `K : IntermediateField ℚ ℂ` with `FiniteDimensional ℚ K`.
* `Kcyc K` is `K(μ_∞)`, the compositum of `K` with the field generated by all roots of
  unity in `ℂ`.
* `monicCentred d a` is `z^d + a_{d-2} z^{d-2} + ⋯ + a_0`, with coefficients
  `a : Fin (d - 1) → R` (so `a i` is the coefficient of `z^i`). It is defined over any
  commutative ring so that `Inputs.lean` can reuse it for families.
* `HasFiniteOrbit f z` says the forward orbit `{z, f z, f (f z), …}` is finite.
* `IsPCF f` says every root of `f'` in `ℂ` has finite forward orbit.
* `MainStatement` is Theorem 1: for every number field `K` and every `d ≥ 2`, only
  finitely many coefficient tuples in `Kcyc K` give a PCF polynomial.
-/

namespace IngramMello

open Polynomial

/-- `ζ` is a root of unity in `ℂ`. -/
def IsRootOfUnityC (ζ : ℂ) : Prop := ∃ n : ℕ, 0 < n ∧ ζ ^ n = 1

/-- The cyclotomic closure `K^cyc = K(μ_∞)` of a subfield `K` of `ℂ`. -/
noncomputable def Kcyc (K : IntermediateField ℚ ℂ) : IntermediateField ℚ ℂ :=
  K ⊔ IntermediateField.adjoin ℚ {ζ : ℂ | IsRootOfUnityC ζ}

/-- The monic centred polynomial `z^d + a_{d-2} z^{d-2} + ⋯ + a_1 z + a_0`. -/
noncomputable def monicCentred {R : Type*} [CommRing R] (d : ℕ) (a : Fin (d - 1) → R) :
    R[X] :=
  X ^ d + ∑ i : Fin (d - 1), C (a i) * X ^ (i : ℕ)

/-- The forward orbit of `z` under `f` is finite. Here `f` has coefficients in `R` and
acts on an `R`-algebra `S`. -/
def HasFiniteOrbit {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (f : R[X]) (z : S) : Prop :=
  (Set.range fun n : ℕ => (fun w => aeval w f)^[n] z).Finite

/-- A complex polynomial is postcritically finite if every root of its derivative has
finite forward orbit. -/
def IsPCF (f : ℂ[X]) : Prop :=
  ∀ c : ℂ, (derivative f).IsRoot c → HasFiniteOrbit f c

/-- **Theorem 1.** For every number field `K ⊆ ℂ` and every `d ≥ 2` there are only
finitely many monic centred PCF polynomials of degree `d` with coefficients in `K^cyc`. -/
def MainStatement : Prop :=
  ∀ K : IntermediateField ℚ ℂ, FiniteDimensional ℚ K → ∀ d : ℕ, 2 ≤ d →
    {a : Fin (d - 1) → ℂ | (∀ i, a i ∈ Kcyc K) ∧ IsPCF (monicCentred d a)}.Finite

end IngramMello
