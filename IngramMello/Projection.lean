import IngramMello.Descent

/-!
# Lemma 9: descent along a torsion coset

If infinitely many points of an exceptional family lie in the image of a torsion coset
`w ↦ η · w^B` with finite kernel, pulling the family back along this map gives an
exceptional family in dimension `s` (the number of columns of `B`), over the number field
generated by `K` and the coordinates of `η`. One lift is chosen per image point, so the
specializations stay pairwise distinct.
-/

namespace IngramMello

open AddMonoidAlgebra

namespace MvLaurent

variable {r s : ℕ}

/-- Pullback `u^e ↦ η^e w^{Bᵀ e}` from Laurent polynomials over `K` to Laurent polynomials
over a larger field `L` containing the coordinates of `η`. -/
noncomputable def pullbackOver {K L : IntermediateField ℚ ℂ} (hKL : K ≤ L)
    (η : Fin r → Lˣ) (B : Matrix (Fin r) (Fin s) ℤ) :
    AddMonoidAlgebra K (Fin r → ℤ) →+* AddMonoidAlgebra L (Fin s → ℤ) :=
  (AddMonoidAlgebra.lift L (AddMonoidAlgebra L (Fin s → ℤ)) (Fin r → ℤ)
    { toFun := fun a => single (B.transpose.mulVec (Multiplicative.toAdd a))
        ((∏ j, η j ^ (Multiplicative.toAdd a) j : Lˣ) : L)
      map_one' := by simp [one_def]
      map_mul' := fun a b => by
        simp [Matrix.mulVec_add, zpow_add, Finset.prod_mul_distrib] }).toRingHom.comp
    (AddMonoidAlgebra.mapRingHom (Fin r → ℤ) (IntermediateField.inclusion hKL).toRingHom)

theorem pullbackOver_single {K L : IntermediateField ℚ ℂ} (hKL : K ≤ L)
    (η : Fin r → Lˣ) (B : Matrix (Fin r) (Fin s) ℤ) (a : Fin r → ℤ) (c : K) :
    pullbackOver hKL η B (single a c) =
      single (B.transpose.mulVec a)
        (IntermediateField.inclusion hKL c * ((∏ j, η j ^ a j : Lˣ) : L)) := by
  simp [pullbackOver, AddMonoidAlgebra.lift_single, smul_single, smul_eq_mul]

/-- Evaluation commutes with `pullbackOver`. -/
theorem evalOver_pullbackOver {K L : IntermediateField ℚ ℂ} (hKL : K ≤ L)
    (η : Fin r → Lˣ) (B : Matrix (Fin r) (Fin s) ℤ) (w : Fin s → ℂˣ)
    (F : AddMonoidAlgebra K (Fin r → ℤ)) :
    evalOver L w (pullbackOver hKL η B F) =
      evalOver K (monomialMap (fun j => Units.map L.val.toMonoidHom (η j)) B w) F := by
  induction F using AddMonoidAlgebra.induction_linear with
  | zero => simp
  | add F G hF hG => simp only [map_add, hF, hG]
  | single a c =>
    rw [pullbackOver_single]
    have h := evalHom_pullback (fun j => Units.map L.val.toMonoidHom (η j)) B w
      (single a (c : ℂ))
    simp only [evalOver, RingHom.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
      mapRingHom_single] at h ⊢
    rw [pullback_single] at h
    convert h using 3
    · simp only [Units.coe_prod, Units.val_zpow_eq_zpow_val, map_mul, map_prod, map_zpow₀]
      rfl
    · rfl


/-- `η (w^{B₂})^{B₁} = η w^{B₁ B₂}`. -/
theorem monomialMap_mul {t : ℕ} (η : Fin r → ℂˣ) (B₁ : Matrix (Fin r) (Fin t) ℤ)
    (B₂ : Matrix (Fin t) (Fin s) ℤ) (w : Fin s → ℂˣ) :
    monomialMap η (B₁ * B₂) w = monomialMap η B₁ (monomialMap 1 B₂ w) := by
  have h := monomialMap_one_comp B₂ B₁ w
  funext j
  have hj := congrFun h j
  simp only [monomialMap, Pi.one_apply, one_mul] at hj ⊢
  rw [hj]

/-- **Integer rank factorization.** Either `Bᵀ : ℤ^r → ℤ^s` is injective (the coset
`w ↦ η w^B` dominates `(ℂ^×)^r`), or `B = B₁ B₂` with `B₁ : ℤ^{r'} → ℤ^r` injective and
`r' < r` (its image lies in a torsion coset of smaller dimension). `B₁` has as columns a
`ℤ`-basis of the column span of `B`. -/
theorem exists_rank_factorization {r s : ℕ} (B : Matrix (Fin r) (Fin s) ℤ) :
    Function.Injective B.transpose.mulVec ∨
      ∃ r' < r, ∃ (B₁ : Matrix (Fin r) (Fin r') ℤ) (B₂ : Matrix (Fin r') (Fin s) ℤ),
        Function.Injective B₁.mulVec ∧ B = B₁ * B₂ := by
  classical
  let V : Submodule ℤ (Fin r → ℤ) := LinearMap.range B.mulVecLin
  obtain ⟨n, b⟩ := Submodule.basisOfPid (Pi.basisFun ℤ (Fin r)) V
  have hcol : ∀ j, B.col j ∈ V := fun j => ⟨Pi.single j 1, by
    funext i; simp [Matrix.mulVec_single]⟩
  let B₁ : Matrix (Fin r) (Fin n) ℤ := Matrix.of fun i k => (b k : Fin r → ℤ) i
  let B₂ : Matrix (Fin n) (Fin s) ℤ := Matrix.of fun k j => b.repr ⟨B.col j, hcol j⟩ k
  have hli : LinearIndependent ℤ B₁.col := by
    have := b.linearIndependent.map' V.subtype V.ker_subtype
    convert this using 1
    funext k
    rfl
  have hB₁ : Function.Injective B₁.mulVec := Matrix.mulVec_injective_iff.2 hli
  have hfac : B = B₁ * B₂ := by
    ext i j
    have h := congrArg (fun x : V => (x : Fin r → ℤ) i) (b.sum_repr ⟨B.col j, hcol j⟩)
    simp only [Submodule.coe_sum, Submodule.coe_smul, Finset.sum_apply, Pi.smul_apply,
      smul_eq_mul] at h
    simp only [Matrix.mul_apply, B₁, B₂, Matrix.of_apply]
    have e : B i j = B.col j i := rfl
    rw [e, ← h]
    exact Finset.sum_congr rfl fun k _ => mul_comm _ _
  have hn : n ≤ r := by
    simpa using hli.fintype_card_le_finrank
  rcases hn.lt_or_eq with hlt | rfl
  · exact Or.inr ⟨n, hlt, B₁, B₂, hB₁, hfac⟩
  · left
    intro v w hvw
    have hv : B.transpose.mulVec (v - w) = 0 := by rw [Matrix.mulVec_sub, hvw, sub_self]
    have h1 : B₁.transpose.mulVec (v - w) = 0 := by
      funext k
      obtain ⟨x, hx⟩ := (b k).2
      have hk : (B₁.transpose.mulVec (v - w)) k = (v - w) ⬝ᵥ (b k : Fin _ → ℤ) := by
        simp [Matrix.mulVec, dotProduct, B₁, mul_comm]
      rw [hk, ← hx, Pi.zero_apply, Matrix.mulVecLin_apply, Matrix.dotProduct_mulVec,
        ← Matrix.mulVec_transpose, hv, zero_dotProduct]
    have hdet : B₁.det ≠ 0 := by
      intro h0
      obtain ⟨u, hu, hu0⟩ := Matrix.exists_mulVec_eq_zero_iff.2 h0
      exact hu (hB₁ (hu0.trans (Matrix.mulVec_zero _).symm))
    by_contra hne
    apply hdet
    rw [← Matrix.det_transpose]
    exact Matrix.exists_mulVec_eq_zero_iff.1 ⟨v - w, sub_ne_zero.2 hne, h1⟩

end MvLaurent

/-- The number field generated by `K` and finitely many roots of unity. -/
theorem finiteDimensional_sup_adjoin_roots (K : IntermediateField ℚ ℂ)
    [FiniteDimensional ℚ K] {r : ℕ} (η : Fin r → ℂ) (hη : ∀ j, IsRootOfUnityC (η j)) :
    FiniteDimensional ℚ (K ⊔ IntermediateField.adjoin ℚ (Set.range η) : IntermediateField ℚ ℂ) := by
  have : FiniteDimensional ℚ (IntermediateField.adjoin ℚ (Set.range η)) := by
    apply IntermediateField.finiteDimensional_adjoin
    rintro _ ⟨j, rfl⟩
    obtain ⟨n, hn, h⟩ := hη j
    exact IsIntegral.of_pow hn (h ▸ isIntegral_one)
  infer_instance

/-- **Lemma 9, descent step.** Suppose infinitely many points of an exceptional family
`(a, T)` over `K` lie on the torsion coset `η · w^B` (with `B.mulVec` injective). Then there
is an exceptional family of dimension `s` over some number field. -/
theorem isExceptional_descent {d : ℕ} {K : IntermediateField ℚ ℂ} [FiniteDimensional ℚ K]
    {r s : ℕ} {a : Fin (d - 1) → AddMonoidAlgebra K (Fin r → ℤ)} {T : Set (Fin r → ℂˣ)}
    (hEx : IsExceptional d K r a T) (η : Fin r → ℂˣ) (hη : ∀ j, IsRootOfUnityC (η j : ℂ))
    (B : Matrix (Fin r) (Fin s) ℤ) (hB : Function.Injective B.mulVec)
    (T₀ : Set (Fin r → ℂˣ)) (hT₀ : T₀ ⊆ T) (hT₀inf : T₀.Infinite)
    (hT₀B : ∀ t ∈ T₀, ∃ w, MvLaurent.monomialMap η B w = t) :
    ∃ (L : IntermediateField ℚ ℂ) (_ : FiniteDimensional ℚ L)
      (a' : Fin (d - 1) → AddMonoidAlgebra L (Fin s → ℤ)) (T' : Set (Fin s → ℂˣ)),
      IsExceptional d L s a' T' := by
  classical
  obtain ⟨-, hTtor, hTpcf, hTinj⟩ := hEx
  let L : IntermediateField ℚ ℂ := K ⊔ IntermediateField.adjoin ℚ (Set.range fun j => (η j : ℂ))
  have hKL : K ≤ L := le_sup_left
  have hηL : ∀ j, (η j : ℂ) ∈ L := fun j =>
    (le_sup_right : _ ≤ L) (IntermediateField.subset_adjoin ℚ _ ⟨j, rfl⟩)
  let ηL : Fin r → Lˣ := fun j =>
    Units.mk0 ⟨η j, hηL j⟩ (fun h => (η j).ne_zero (congrArg Subtype.val h))
  have hηη : (fun j => Units.map L.val.toMonoidHom (ηL j)) = η := by
    funext j; ext; rfl
  let g : (Fin r → ℂˣ) → (Fin s → ℂˣ) := fun t =>
    if h : ∃ w, MvLaurent.monomialMap η B w = t then h.choose else 1
  have hg : ∀ t ∈ T₀, MvLaurent.monomialMap η B (g t) = t := fun t ht => by
    simp only [g, dite_eq_left (hT₀B t ht)]
    exact (hT₀B t ht).choose_spec
  have hev : ∀ t ∈ T₀, ∀ F, MvLaurent.evalOver L (g t) (MvLaurent.pullbackOver hKL ηL B F) =
      MvLaurent.evalOver K t F := fun t ht F => by
    rw [MvLaurent.evalOver_pullbackOver, hηη, hg t ht]
  refine ⟨L, finiteDimensional_sup_adjoin_roots K _ hη,
    fun i => MvLaurent.pullbackOver hKL ηL B (a i), g '' T₀, ?_, ?_, ?_, ?_⟩
  · refine hT₀inf.image fun t ht t' ht' h => ?_
    rw [← hg t ht, ← hg t' ht', h]
  · rintro _ ⟨t, ht, rfl⟩ k
    rw [MvLaurent.isRootOfUnityC_iff_isOfFinOrder]
    refine MvLaurent.isOfFinOrder_of_monomialMap η B hB
      (fun j => (MvLaurent.isRootOfUnityC_iff_isOfFinOrder _).1 (hη j)) _ (fun j => ?_) k
    rw [hg t ht, ← MvLaurent.isRootOfUnityC_iff_isOfFinOrder]
    exact hTtor t (hT₀ ht) j
  · rintro _ ⟨t, ht, rfl⟩
    simp only [hev t ht]
    exact hTpcf t (hT₀ ht)
  · rintro _ ⟨t, ht, rfl⟩ _ ⟨t', ht', rfl⟩ h
    simp only [hev t ht, hev t' ht'] at h
    rw [hTinj (hT₀ ht) (hT₀ ht') h]

end IngramMello
